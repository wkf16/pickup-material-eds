[Unit]
Description=Lab box connectivity watchdog (passive logger)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/net-watch
Restart=on-failure
RestartSec=10
# Keep log size bounded; rotate manually if it ever matters.
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
